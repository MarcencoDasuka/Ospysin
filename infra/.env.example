# Environment Variables Template for Ospysin / OSINT & Security Audit Platform

# Application Profile
APP_ENV=local
SERVER_PORT=8080
# Host interface binding (default: 127.0.0.1 for local isolation. Exposing to 0.0.0.0 requires an authenticating TLS reverse proxy)
APP_BIND_HOST=127.0.0.1

# Cookie Security (false for local plain HTTP, true when behind TLS reverse proxy)
COOKIE_SECURE=false

# Initial Admin Bootstrap Password (used on first DB initialization)
ADMIN_INITIAL_PASSWORD=admin_secret_locally

# PostgreSQL Configuration (Dual-Role Privilege Separation per 11-DATA-MODEL.md)
POSTGRES_DB=ospysin
POSTGRES_USER=ospysin_admin
POSTGRES_PASSWORD=admin_secret_locally
FLYWAY_USER=flyway_user
FLYWAY_PASSWORD=flyway_secret_locally
APP_DB_USER=ospysin_app
APP_DB_PASSWORD=app_secret_locally
POSTGRES_HOST=postgres
POSTGRES_PORT=5432

# Ollama / Local LLM (Pinned artifact from Hugging Face via Ollama)
OLLAMA_BASE_URL=http://host.docker.internal:11434
OLLAMA_MODEL=hf.co/RavichandranJ/Dolphin3-Cyber-8B-GGUF:Q4_K_M

# Network & Policy Safety Mode (LOCAL | PUBLIC)
DEFAULT_AUDIT_MODE=LOCAL

# Frontend Configuration
FRONTEND_PORT=5173
VITE_API_BASE_URL=http://localhost:8080
